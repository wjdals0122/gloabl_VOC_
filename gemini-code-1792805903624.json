{
  "name": "[시트 1] 메인 컨트롤러 (1-Depth 생성 및 라우팅)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "voc-crawler-start",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "sheet1-webhook-01",
      "name": "Webhook (UI 입력 수신)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [180, 340],
      "webhookId": "voc-crawler-start"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "[https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent](https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent)",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "YOUR_FREE_GEMINI_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": \"너는 글로벌 마켓 리서치 전문가야.\\n대상 국가: {{ $json.body.country || 'US' }}\\n제품 키워드: {{ $json.body.keyword || 'Smart Ring' }}\\n\\n위 국가에서 해당 제품에 대한 소비자 반응(VOC)과 리뷰를 수집할 수 있는 대표 사이트들의 '검색 결과 페이지 URL(1-Depth)' 리스트를 생성해 줘.\\n반드시 Reddit 검색 링크 1개와 해당 국가의 대표 E-commerce, Tech Review, Community/Forum 사이트를 포함해야 해.\\n존재하지 않는 상세 페이지 URL을 지어내지 말고 실제 검색 쿼리 URL 패턴을 사용해.\\n\\n응답은 반드시 아래 JSON 배열 포맷으로만 출력해:\\n[{\\\"url\\\": \\\"https://...\\\", \\\"category\\\": \\\"E-commerce | Community/Forum | Tech Review | Price Comparison 중 택1\\\", \\\"site_name\\\": \\\"사이트명\\\"}]\"\n    }]\n  }],\n  \"generationConfig\": {\n    \"responseMimeType\": \"application/json\"\n  }\n}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "sheet1-gemini-02",
      "name": "Gemini (1-Depth 검색링크 생성)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 340],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const rawText = $input.first().json?.candidates?.[0]?.content?.parts?.[0]?.text || '[]';\nconst country = $('Webhook (UI 입력 수신)').first().json.body?.country || 'US';\nconst keyword = $('Webhook (UI 입력 수신)').first().json.body?.keyword || '';\n\nlet parsedList = [];\ntry {\n  parsedList = JSON.parse(rawText.replace(/```json|```/g, '').trim());\n} catch (e) {\n  parsedList = [];\n}\n\nreturn parsedList.map(item => ({\n  json: {\n    url: item.url,\n    category: item.category || 'Community/Forum',\n    site_name: item.site_name || 'Unknown',\n    country: country,\n    keyword: keyword\n  }\n}));"
      },
      "id": "sheet1-code-03",
      "name": "1-Depth 리스트 분리 (Split)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 340]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "sheet1-loop-04",
      "name": "Loop Over 1-Depth Links",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [900, 340]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.url }}",
                    "rightValue": "reddit.com",
                    "operator": { "type": "string", "operation": "contains" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Reddit"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.category }}",
                    "rightValue": "E-commerce",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "E-commerce"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.category }}",
                    "rightValue": "Community/Forum",
                    "operator": { "type": "string", "operation": "equals" }
                  },
                  {
                    "leftValue": "={{ $json.category }}",
                    "rightValue": "Tech Review",
                    "operator": { "type": "string", "operation": "equals" }
                  },
                  {
                    "leftValue": "={{ $json.category }}",
                    "rightValue": "Price Comparison",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "or"
              },
              "renameOutput": true,
              "outputKey": "Other Categories"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "id": "sheet1-switch-05",
      "name": "Category & URL Router",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1140, 340]
    },
