    },
    "Loop Over 2-Depth Pages": {
      "main": [
        [],
        [{ "node": "ScrapingAnt (Depth 2: 상세페이지 수집)", "type": "main", "index": 0 }]
      ]
    },
    "ScrapingAnt (Depth 2: 상세페이지 수집)": {
      "main": [[{ "node": "상세 마크다운 절삭", "type": "main", "index": 0 }]]
    },
    "상세 마크다운 절삭": {
      "main": [[{ "node": "Wait 5s (Rate Limit 보호)", "type": "main", "index": 0 }]]
