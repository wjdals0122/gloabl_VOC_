    "Wait 5s (Rate Limit 보호)": {
      "main": [[{ "node": "Gemini (개별 리뷰/VOC 추출)", "type": "main", "index": 0 }]]
    },
    "Gemini (개별 리뷰/VOC 추출)": {
      "main": [[{ "node": "VOC 스키마 변환 (Row 생성)", "type": "main", "index": 0 }]]
    },
    "VOC 스키마 변환 (Row 생성)": {
      "main": [[{ "node": "Loop Over 2-Depth Pages", "type": "main", "index": 0 }]]
    }
  }
